[Unit]
Description=D-Scope Credential Issuer Puller v22
After=network-online.target dscope-issuer.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dscope/backend
Environment=PATH=/root/.aztec/current/bin:/root/.aztec/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash -lc 'set -a; source /opt/dscope/backend/.env.testnet-runner; set +a; export RUNNER_API_BASE_URL="${RUNNER_API_BASE_URL:-https://app.dscope.app}"; exec /usr/bin/node /opt/dscope/backend/scripts/credential-issuer-puller.v22.mjs'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
