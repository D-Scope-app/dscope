**/target/*
!contracts/dscope_core/target/
!contracts/dscope_core/target/dscope_core-DScopeCore.json
!contracts/participation_gate_v2/target/
!contracts/participation_gate_v2/target/participation_gate_v2-ParticipationGateV2.json
!contracts/reward_vault_mvp/target/
